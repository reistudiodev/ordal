# Copy to .env (git-ignored) for local release builds: scripts/release-macos.sh reads it.
# In GitHub Actions, add the same names as repository secrets instead.

# Developer ID Application certificate, exported from Keychain Access as .p12:
#   base64 -i DeveloperID.p12 | pbcopy
MACOS_CERTIFICATE=
MACOS_CERTIFICATE_PWD=

# App Store Connect API key (Users and Access > Integrations > App Store Connect API),
# used by notarytool:
#   base64 -i AuthKey_XXXXXXXXXX.p8 | pbcopy
APPLE_API_KEY_ID=
APPLE_API_ISSUER=
APPLE_API_KEY_BASE64=
